# Pass these as environment variables, or copy this file to ../.env.dispatcher.
# The local file is ignored by Git and loaded by run.py, including LocalLink launches.
MONITOR_REPOSITORY_ROOT=/absolute/path/to/projects
MONITOR_ROUTER_MODEL=gpt-6-luna
MONITOR_ROUTER_EFFORT=low
MONITOR_WORKER_MODEL=gpt-6.1-sol
MONITOR_REPOSITORY_SCAN_DEPTH=3
