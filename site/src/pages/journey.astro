---
import Layout from '../layouts/Layout.astro';
import milestones from '../data/journey.json';
const repository = 'https://github.com/cmwen/FNK0104B';
---
<Layout title="Build journal">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Lessons from building the board</p>
      <h1>Small experiments.<br />A capable appliance.</h1>
      <p class="lede">A trail through the repository’s decisions, experiments and device evidence, newest first.</p>
    </header>
    <div class="prose timeline">
      <p>Dates follow milestone commits or, for uncommitted work, the development session in Australia/Sydney local time. Hardware records keep their original test dates; implementation, owner confirmation and remaining physical checks are described separately.</p>
      {milestones.map(({timestamp, sha, title, paragraphs, links}) => (
        <article>
          <h2><time datetime={timestamp}>{timestamp.slice(0, 10)}</time> · {title}</h2>
          {paragraphs.map(body => <p>{body}</p>)}
          {links.map(({label, path}) => <p><a href={`${repository}/blob/main/${path}`}>{label} ↗</a></p>)}
          {sha ? <p><a href={`${repository}/commit/${sha}`}><code>{sha}</code> · inspect the milestone ↗</a></p> : <p>Local implementation · not yet committed or published.</p>}
        </article>
      ))}
    </div>
  </div>
</Layout>
