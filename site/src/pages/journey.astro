---
import Layout from '../layouts/Layout.astro';
import milestones from '../data/journey.json';
const chapters = [...milestones].reverse();
const repository = 'https://github.com/cmwen/FNK0104B';
---
<Layout title="The story behind the firmware">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">The story behind the firmware</p>
      <h1>From a board of possibilities.<br />To a desk companion.</h1>
      <p class="lede">How a collection of small applications grew into a Codex monitor, found its voice, connected to Desktop and gained a little personality.</p>
    </header>
    <div class="prose timeline">
      <p>Read from the beginning: each chapter follows a turning point in the application’s history. Dates mark milestones in Australia/Sydney local time.</p>
      {chapters.map(({timestamp, title, paragraphs, links}) => (
        <article>
          <h2><time datetime={timestamp}>{timestamp.slice(0, 10)}</time> · {title}</h2>
          {paragraphs.map(body => <p>{body}</p>)}
          {links.map(({label, path}) => <p><a href={`${repository}/blob/main/${path}`}>{label} ↗</a></p>)}
        </article>
      ))}
    </div>
  </div>
</Layout>
